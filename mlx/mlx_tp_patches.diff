+
+// Coherence and signal in one dispatch: a single threadgroup makes the whole
+// input visible (each thread a few elements), then its first thread writes the
+// timestamp. No atomics: they are not available on coherent pointers.
+[[kernel]] void input_coherent_update(
+    volatile coherent(system) device uint* input [[buffer(0)]],
+    const constant uint& size [[buffer(1)]],
+    volatile coherent(system) device uint* timestamp [[buffer(2)]],
+    constant uint& value [[buffer(3)]],
+    const constant uint& per [[buffer(4)]],
+    uint lid [[thread_position_in_threadgroup]]) {
+  for (uint j = 0; j < per; j++) {
+    const uint i = lid * per + j;
+    if (i < size) {
+      input[i] = input[i];
+    }
+  }
+  metal::atomic_thread_fence(
+      metal::mem_flags::mem_device,
+      metal::memory_order_seq_cst,
+      metal::thread_scope_system);
+  threadgroup_barrier(metal::mem_flags::mem_device);
+  if (lid == 0) {
+    timestamp[0] = value;
+    metal::atomic_thread_fence(
+        metal::mem_flags::mem_device,
+        metal::memory_order_seq_cst,
+        metal::thread_scope_system);
+  }
+}
